+def test_disabled_read_metrics_do_not_call_timer():
+    store = FakeStore()
+    store.get = MagicMock(return_value=[0, 0])
+    thread = KVCacheStoreRecvingThread(
+        m_store=store,
+        token_database=FakeTokenDatabase(),
